                        </div>
                        <div class="p-4 space-y-2">
                            <h3 class="font-serif font-bold text-lg text-brand-950 group-hover:text-brand-700 transition">${product.name}</h3>
                            <p class="text-xs text-brand-600 font-light leading-relaxed line-clamp-2">${product.description}</p>
                        </div>
                    </div>
                    <div class="p-4 pt-0">
                        <button onclick="openCustomizeModal('${product.id}')" class="w-full bg-brand-100 hover:bg-brand-800 text-brand-900 hover:text-gold-400 font-semibold py-2.5 px-4 rounded-xl border border-brand-200 hover:border-brand-700 transition duration-200 flex items-center justify-center space-x-2 text-xs">
                            <i class="fa-solid fa-sliders"></i>
                            <span>Personalizar y Agregar</span>
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // ABRIR MODAL
        function openCustomizeModal(productId) {
            const product = MENU_DATA.find(p => p.id === productId);
            if (!product) return;

            selectedProductForModal = product;
            modalQuantity = 1;
            selectedSize = { name: 'Regular (350ml)', extraPrice: 0 };

            document.getElementById('modal-item-title').innerText = product.name;
            document.getElementById('modal-item-desc').innerText = product.description;
            document.getElementById('modal-category-badge').innerText = getCategoryLabel(product.category);
            document.getElementById('modal-qty').innerText = modalQuantity;
            document.getElementById('modal-notes').value = '';

            const isBeverage = product.category === 'clasicos' || product.category === 'frias';
            document.getElementById('section-size').style.display = isBeverage ? 'block' : 'none';
            document.getElementById('section-milk').style.display = product.hasMilk ? 'block' : 'none';
            document.getElementById('section-sugar').style.display = isBeverage ? 'block' : 'none';

            const sizeContainer = document.getElementById('options-size');
            sizeContainer.innerHTML = '';
            if (isBeverage) {
                const sizes = [
                    { name: 'Chico (250ml)', extra: 0 },
                    { name: 'Regular (350ml)', extra: 8 },
                    { name: 'Grande (470ml)', extra: 16 }
                ];
                sizes.forEach((s, idx) => {
                    const isChecked = idx === 0 ? 'checked' : '';
                    if (idx === 0) selectedSize = { name: s.name, extraPrice: s.extra };
                    
                    sizeContainer.innerHTML += `
                        <label class="cursor-pointer">
                            <input type="radio" name="modal-size-radio" value="${s.extra}" ${isChecked} onchange="updateModalSize('${s.name}', ${s.extra})" class="peer hidden">
                            <div class="text-center p-2 rounded-xl border border-brand-200 peer-checked:border-brand-600 peer-checked:bg-brand-100 peer-checked:text-brand-900 transition">
                                <p class="text-xs font-bold text-brand-900">${s.name.split(' ')[0]}</p>
                                <p class="text-[10px] text-brand-600">+ $${s.extra.toFixed(2)}</p>
                            </div>
                        </label>
                    `;
                });
            }

            const extrasContainer = document.getElementById('options-extras-container');
            extrasContainer.innerHTML = '';
            let extrasList = isBeverage ? [
                { id: 'ext-whip', name: 'Crema Batida Artesanal', price: 12.00 },
                { id: 'ext-shot', name: 'Shot Extra de Espresso', price: 15.00 },
                { id: 'ext-syrup', name: 'Jarabe de Vainilla / Caramel', price: 10.00 },
                { id: 'ext-cinnamon', name: 'Especia Canela Extra', price: 0.00 }
            ] : [
                { id: 'ext-butter', name: 'Mantequilla Adicional', price: 8.00 },
                { id: 'ext-jam', name: 'Mermelada de Fresa Casera', price: 10.00 },
                { id: 'ext-cheese', name: 'Queso Extra', price: 15.00 }
            ];

            extrasList.forEach(ext => {
                extrasContainer.innerHTML += `
                    <label class="flex items-center justify-between p-2 rounded-lg hover:bg-brand-50 border border-brand-100 cursor-pointer">
                        <div class="flex items-center space-x-2">
                            <input type="checkbox" data-price="${ext.price}" data-name="${ext.name}" onchange="recalculateModalPrice()" class="extra-checkbox rounded text-brand-700 focus:ring-brand-500 h-4 w-4">
                            <span class="text-xs font-medium text-brand-900">${ext.name}</span>
                        </div>
                        <span class="text-xs text-brand-600 font-semibold">${ext.price > 0 ? '+ $' + ext.price.toFixed(2) : 'Gratis'}</span>
                    </label>
                `;
            });

            recalculateModalPrice();

            const modal = document.getElementById('customize-modal');
            const card = document.getElementById('customize-modal-card');
            modal.classList.remove('hidden');
            setTimeout(() => {
                card.classList.remove('scale-95', 'opacity-0');
                card.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeCustomizeModal() {
            const modal = document.getElementById('customize-modal');
            const card = document.getElementById('customize-modal-card');
            card.classList.remove('scale-100', 'opacity-100');
            card.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        function updateModalSize(name, extraPrice) {
            selectedSize = { name, extraPrice };
            recalculateModalPrice();
        }

        function adjustModalQty(delta) {
            modalQuantity = Math.max(1, modalQuantity + delta);
            document.getElementById('modal-qty').innerText = modalQuantity;
            recalculateModalPrice();
        }

        function recalculateModalPrice() {
            if (!selectedProductForModal) return;

            let unitPrice = selectedProductForModal.price;

            if (selectedSize) {
                unitPrice += selectedSize.extraPrice;
            }

            const milkSelect = document.getElementById('option-milk-select');
            if (selectedProductForModal.hasMilk && milkSelect) {
                if (milkSelect.value === 'Almendra' || milkSelect.value === 'Avena' || milkSelect.value === 'Coco') {
                    unitPrice += 12.00;
                }
            }

            const checkedExtras = document.querySelectorAll('.extra-checkbox:checked');
            checkedExtras.forEach(cb => {
                unitPrice += parseFloat(cb.getAttribute('data-price') || 0);
            });

            const totalPrice = unitPrice * modalQuantity;
            document.getElementById('modal-calculated-price').innerText = `$${totalPrice.toFixed(2)}`;
            return { unitPrice, totalPrice };
        }

        function confirmAddToCart() {
            if (!selectedProductForModal) return;

            const isBeverage = selectedProductForModal.category === 'clasicos' || selectedProductForModal.category === 'frias';
            const selectedMilk = selectedProductForModal.hasMilk ? document.getElementById('option-milk-select').value : null;
            
            let selectedSugar = null;
            if (isBeverage) {
                const sugarRadio = document.querySelector('input[name="sugar"]:checked');
                selectedSugar = sugarRadio ? sugarRadio.value : 'Normal';
            }

            const extras = [];
            document.querySelectorAll('.extra-checkbox:checked').forEach(cb => {
                extras.push(cb.getAttribute('data-name'));
            });

            const notes = document.getElementById('modal-notes').value.trim();
            const prices = recalculateModalPrice();

            const cartItem = {
                cartItemId: Date.now().toString(),
                productId: selectedProductForModal.id,
                name: selectedProductForModal.name,
                basePrice: selectedProductForModal.price,
                unitPrice: prices.unitPrice,
                quantity: modalQuantity,
                size: isBeverage ? selectedSize.name : null,
                milk: selectedMilk,
                sugar: selectedSugar,
                extras: extras,
                notes: notes
            };

            cart.push(cartItem);
            updateCartUI();
            closeCustomizeModal();
            showToast(`¡${selectedProductForModal.name} agregado al pedido!`);
        }

        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            const headerTotal = document.getElementById('cart-header-total');
            const cartContainer = document.getElementById('cart-items-container');
            const emptyView = document.getElementById('empty-cart-view');
            const cartFooter = document.getElementById('cart-summary-footer');
            const cartNotesSec = document.getElementById('cart-notes-section');

            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            const subtotal = cart.reduce((sum, item) => sum + (item.unitPrice * item.quantity), 0);

            if (totalItems > 0) {
                badge.innerText = totalItems;
                badge.classList.remove('hidden');
                headerTotal.innerText = `$${subtotal.toFixed(2)}`;
            } else {
                badge.classList.add('hidden');
                headerTotal.innerText = '$0.00';
            }

            cartContainer.innerHTML = '';
            if (cart.length === 0) {
                emptyView.classList.remove('hidden');
                cartFooter.classList.add('hidden');
                cartNotesSec.classList.add('hidden');
            } else {
                emptyView.classList.add('hidden');
                cartFooter.classList.remove('hidden');
                cartNotesSec.classList.remove('hidden');

                cart.forEach(item => {
                    const itemEl = document.createElement('div');
                    itemEl.className = "bg-white p-3.5 rounded-xl border border-brand-200 shadow-sm flex flex-col justify-between space-y-2";
                    
                    let detailsHTML = '';
                    if (item.size) detailsHTML += `<span class="bg-brand-100 text-brand-800 px-1.5 py-0.5 rounded">${item.size}</span> `;
                    if (item.milk) detailsHTML += `<span class="bg-brand-100 text-brand-800 px-1.5 py-0.5 rounded">Leche: ${item.milk}</span> `;
                    if (item.sugar) detailsHTML += `<span class="bg-brand-100 text-brand-800 px-1.5 py-0.5 rounded">Azúcar: ${item.sugar}</span> `;

                    itemEl.innerHTML = `
                        <div class="flex justify-between items-start">
                            <div>
                                <h4 class="font-bold text-sm text-brand-950">${item.name}</h4>
                                <p class="text-xs text-brand-700 font-semibold">$${item.unitPrice.toFixed(2)} c/u</p>
                            </div>
                            <button onclick="removeFromCart('${item.cartItemId}')" class="text-red-400 hover:text-red-600 text-xs p-1">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>

                        ${detailsHTML ? `<div class="text-[10px] text-brand-600 space-x-1 space-y-1">${detailsHTML}</div>` : ''}
                        
                        ${item.extras.length > 0 ? `
                            <p class="text-[10px] text-brand-600"><strong>Extras:</strong> ${item.extras.join(', ')}</p>
                        ` : ''}

                        ${item.notes ? `
                            <p class="text-[10px] text-amber-800 bg-amber-50 p-1.5 rounded border border-amber-200">
                                <i class="fa-regular fa-comment mr-1"></i>"${item.notes}"
                            </p>
                        ` : ''}

                        <div class="flex justify-between items-center pt-2 border-t border-brand-100">
                            <div class="flex items-center space-x-2">
                                <button onclick="updateCartItemQty('${item.cartItemId}', -1)" class="w-6 h-6 rounded bg-brand-100 text-brand-900 font-bold text-xs flex items-center justify-center hover:bg-brand-200">-</button>
                                <span class="text-xs font-bold text-brand-900 w-4 text-center">${item.quantity}</span>
                                <button onclick="updateCartItemQty('${item.cartItemId}', 1)" class="w-6 h-6 rounded bg-brand-100 text-brand-900 font-bold text-xs flex items-center justify-center hover:bg-brand-200">+</button>
                            </div>
                            <span class="font-bold text-sm text-brand-950">$${(item.unitPrice * item.quantity).toFixed(2)}</span>
                        </div>
                    `;
                    cartContainer.appendChild(itemEl);
                });
            }

            const tax = subtotal * 0.16;
            document.getElementById('summary-subtotal').innerText = `$${subtotal.toFixed(2)}`;
            document.getElementById('summary-tax').innerText = `$${tax.toFixed(2)}`;
            document.getElementById('summary-total').innerText = `$${subtotal.toFixed(2)}`;
        }

        function removeFromCart(cartItemId) {
            cart = cart.filter(item => item.cartItemId !== cartItemId);
            updateCartUI();
        }

        function updateCartItemQty(cartItemId, delta) {
            const item = cart.find(i => i.cartItemId === cartItemId);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) {
                    removeFromCart(cartItemId);
                } else {
                    updateCartUI();
                }
            }
        }

        function setOrderMode(mode) {
            orderMode = mode;
            const btnTable = document.getElementById('btn-mode-table');
            const btnTakeout = document.getElementById('btn-mode-takeout');
            const tableContainer = document.getElementById('table-number-container');

            if (mode === 'table') {
                btnTable.className = "py-2.5 px-3 rounded-lg border border-brand-700 bg-brand-800 text-white font-medium text-xs flex items-center justify-center space-x-2 transition";
                btnTakeout.className = "py-2.5 px-3 rounded-lg border border-brand-200 bg-white text-brand-800 font-medium text-xs flex items-center justify-center space-x-2 transition";
                tableContainer.style.display = 'block';
            } else {
                btnTakeout.className = "py-2.5 px-3 rounded-lg border border-brand-700 bg-brand-800 text-white font-medium text-xs flex items-center justify-center space-x-2 transition";
                btnTable.className = "py-2.5 px-3 rounded-lg border border-brand-200 bg-white text-brand-800 font-medium text-xs flex items-center justify-center space-x-2 transition";
                tableContainer.style.display = 'none';
            }
        }

        function toggleCartModal() {
            const modal = document.getElementById('cart-modal');
            const drawer = document.getElementById('cart-drawer');

            if (modal.classList.contains('hidden')) {
                modal.classList.remove('hidden');
                setTimeout(() => {
                    drawer.classList.remove('translate-x-full');
                }, 10);
            } else {
                drawer.classList.add('translate-x-full');
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 300);
            }
        }

        function processCheckout() {
            if (cart.length === 0) return;

            const randomOrderId = '#COL-' + Math.floor(1000 + Math.random() * 9000);
            const now = new Date();
            const dateStr = now.toLocaleDateString() + ' ' + now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            
            const tableNum = orderMode === 'table' ? document.getElementById('select-table-num').value : 'Para Llevar';
            const subtotal = cart.reduce((sum, item) => sum + (item.unitPrice * item.quantity), 0);
            const estimatedMinutes = Math.floor(8 + Math.random() * 8);

            document.getElementById('ticket-order-id').innerText = randomOrderId;
            document.getElementById('ticket-date').innerText = dateStr;
            document.getElementById('ticket-mode').innerText = tableNum;
            document.getElementById('ticket-eta').innerText = `~${estimatedMinutes} min`;
            document.getElementById('ticket-total').innerText = `$${subtotal.toFixed(2)}`;

            const itemsContainer = document.getElementById('ticket-items-list');
            itemsContainer.innerHTML = '';

            cart.forEach(item => {
                itemsContainer.innerHTML += `
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="font-bold text-brand-950">${item.quantity}x ${item.name}</p>
                            ${item.size ? `<p class="text-[9px] text-brand-600">${item.size}</p>` : ''}
                        </div>
                        <span class="font-bold text-brand-900">$${(item.unitPrice * item.quantity).toFixed(2)}</span>
                    </div>
                `;
            });

            toggleCartModal();
            
            setTimeout(() => {
                document.getElementById('ticket-modal').classList.remove('hidden');
            }, 300);
        }

        function resetApp() {
            cart = [];
            updateCartUI();
            document.getElementById('ticket-modal').classList.add('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function getCategoryLabel(cat) {
            switch(cat) {
                case 'clasicos': return 'Café Clásico';
                case 'frias': return 'Bebida Fría / Especial';
                case 'reposteria': return 'Panadería Tradicional';
                case 'salados': return 'Desayuno & Salado';
                default: return 'Especialidad';
            }
        }

        function showToast(message) {
            const toast = document.createElement('div');
            toast.className = "fixed bottom-5 right-5 bg-brand-950 text-gold-400 px-4 py-3 rounded-xl shadow-2xl border border-gold-500/40 text-xs font-bold z-50 flex items-center space-x-2 animate-bounce";
            toast.innerHTML = `<i class="fa-solid fa-circle-check text-green-400 text-sm"></i> <span>${message}</span>`;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.remove();
            }, 2500);
        }
    </script>
</body>
</html>

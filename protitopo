            const filtered = currentCategory === 'all' 
                ? MENU_DATA 
                : MENU_DATA.filter(p => p.category === currentCategory);

            filtered.forEach(product => {
                const card = document.createElement('div');
                card.className = "bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md border border-brand-200/80 transition duration-300 flex flex-col justify-between group";
                
                card.innerHTML = `
                    <div>
                        <div class="relative h-48 overflow-hidden bg-brand-100">
                            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" onerror="this.src='https://via.placeholder.com/600x400/321f17/dec7a7?text=Cafe+Colonial'">
                            ${product.popular ? `
                                <span class="absolute top-3 left-3 bg-gold-500 text-brand-950 text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full shadow-md">
                                    <i class="fa-solid fa-star mr-1"></i> Favorito
                                </span>
                            ` : ''}
                            <span class="absolute bottom-3 right-3 bg-brand-950/80 backdrop-blur-md text-gold-400 font-bold text-sm px-3 py-1 rounded-lg border border-gold-500/30">
                                $${product.price.toFixed(2)}
